# =============================================================================
# QuantFlow configuration
#
# Copy to `.env` and fill in.  Nested settings use a double underscore:
#     QF_<SECTION>__<FIELD>
#
# NEVER commit `.env`. It is gitignored — verify with:  git check-ignore .env
# Every value below is a PLACEHOLDER. No real credential belongs in this file.
# =============================================================================


# =============================================================================
#  SECTION 1 — SAFE DEFAULTS
#  This file as shipped runs in PAPER mode against the DEMO venue.
#  Nothing here can place an order with real money.
# =============================================================================

# backtest | paper | live        <- `paper` simulates fills; no venue order is sent.
QF_TRADING__MODE=paper
QF_TRADING__BASE_CURRENCY=USDT
QF_TRADING__STARTING_EQUITY=10000

# demo | testnet | mainnet       <- `demo` = api-demo.bybit.com. Real engine, virtual funds.
QF_EXCHANGE__ENV=demo
QF_EXCHANGE__NAME=bybit
QF_EXCHANGE__MARKET_TYPE=spot            # spot | future
QF_EXCHANGE__RATE_LIMIT_PER_SECOND=10
QF_EXCHANGE__REQUEST_TIMEOUT_SECONDS=15
QF_EXCHANGE__MAX_RETRIES=4


# =============================================================================
#  SECTION 2 — DEMO CREDENTIALS  (recommended: start here)
#
#  Bybit -> switch to "Demo Trading" -> API -> create a key SCOPED TO DEMO.
#  Grant TRADE permission only. NEVER grant withdrawal. IP-restrict it.
#
#  A demo key does not work on mainnet and a mainnet key does not work on demo.
#  Leave BOTH blank to run backtests and read public market data.
# =============================================================================

QF_EXCHANGE__DEMO_API_KEY=
QF_EXCHANGE__DEMO_API_SECRET=


# =============================================================================
#  SECTION 3 — LIVE TRADING  ***  REAL MONEY  ***
#
#  ############################################################################
#  #  DANGER. Uncommenting this block arms real orders against real funds.    #
#  #                                                                          #
#  #  You can lose everything in this account. This software has NO proven    #
#  #  edge; its own research report records that no strategy tested beat      #
#  #  simply holding the asset. Demo results do not predict live results.     #
#  #                                                                          #
#  #  Before you uncomment anything below:                                    #
#  #    1. Run in DEMO long enough to see a LOSING streak, not a winning one. #
#  #    2. Set every QF_RISK__* limit below deliberately. The defaults are    #
#  #       examples, not advice.                                              #
#  #    3. Create a MAINNET key with TRADE permission only — never            #
#  #       withdrawal — and IP-restrict it.                                   #
#  #    4. Know how to stop the bot and flatten:                              #
#  #         touch scratchpad/BOT_STOP                                        #
#  #         quantflow risk halt                                              #
#  #    5. Accept that you may lose the entire balance.                       #
#  #                                                                          #
#  #  All FOUR lines below must be set. Miss one and the process refuses to   #
#  #  start rather than trading anyway. That refusal is the feature.          #
#  ############################################################################
#
# QF_TRADING__MODE=live
# QF_TRADING__LIVE_CONFIRMATION=I_UNDERSTAND_THE_RISK
# QF_EXCHANGE__ENV=mainnet
# QF_EXCHANGE__API_KEY=
# QF_EXCHANGE__API_SECRET=
#
#  QF_TRADING__LIVE_CONFIRMATION is NOT a secret. It is a fixed, public token
#  whose only job is to stop anyone reaching live order flow by changing one
#  variable. It protects against accidents, not against attackers.


# =============================================================================
#  SECTION 4 — RISK LIMITS
#  All mandatory. The engine refuses to start without them.
#  These are STARTING POINTS, not recommendations. Set them yourself.
# =============================================================================

QF_RISK__MAX_POSITION_PCT=0.10           # max notional per position / equity
QF_RISK__MAX_TOTAL_EXPOSURE_PCT=0.60     # max aggregate gross notional / equity
QF_RISK__MAX_CONCURRENT_POSITIONS=5
QF_RISK__MAX_DAILY_LOSS_PCT=0.03         # halts new entries for the UTC day
QF_RISK__MAX_DRAWDOWN_PCT=0.15           # LATCHES the kill switch
QF_RISK__DEFAULT_STOP_LOSS_PCT=0.02
QF_RISK__MAX_LEVERAGE=1
QF_RISK__REQUIRE_STOP_LOSS=true
QF_RISK__MAX_ORDER_NOTIONAL=5000


# =============================================================================
#  SECTION 5 — APPLICATION
# =============================================================================

QF_ENV=development                       # development | staging | production | test
QF_DEBUG=true
QF_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
QF_LOG_FORMAT=console                    # console | json  (use json in production)

# SECURITY: several API routers (dashboard, account, portfolio, analytics) have NO
# authentication, and X-API-Key is enforced only in production-like environments.
# Those routers return your balance, positions, orders and PnL.
# KEEP THIS ON LOOPBACK. For remote access use an SSH tunnel or an authenticating
# reverse proxy — never an open port.
QF_API_HOST=127.0.0.1
QF_API_PORT=8000
QF_API_WORKERS=1
QF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in staging/production. Generate with: openssl rand -hex 32
QF_API_KEY=
QF_SECRET_KEY=


# =============================================================================
#  SECTION 6 — INFRASTRUCTURE
#  Host ports are non-standard so they cannot collide with another Postgres or
#  Redis already running on this machine. docker-compose binds them to 127.0.0.1.
# =============================================================================

QF_DB_PORT=55432
QF_REDIS_PORT=56379
QF_API_HOST_PORT=8100

QF_DATABASE__HOST=localhost
QF_DATABASE__PORT=55432
QF_DATABASE__USER=quantflow
QF_DATABASE__PASSWORD=quantflow          # CHANGE THIS if the DB is not loopback-only
QF_DATABASE__NAME=quantflow
QF_DATABASE__POOL_SIZE=10
QF_DATABASE__MAX_OVERFLOW=20
QF_DATABASE__ECHO=false

QF_REDIS__HOST=localhost
QF_REDIS__PORT=56379
QF_REDIS__DB=0
QF_REDIS__PASSWORD=                      # empty is safe ONLY while Redis is loopback-only


# =============================================================================
#  SECTION 7 — STORAGE
# =============================================================================

QF_STORAGE__DATA_DIR=./data
QF_STORAGE__REPORT_DIR=./reports


# =============================================================================
#  SECTION 8 — NOTIFICATIONS (optional)
# =============================================================================

QF_NOTIFICATIONS__TELEGRAM_ENABLED=false
QF_NOTIFICATIONS__TELEGRAM_BOT_TOKEN=
QF_NOTIFICATIONS__TELEGRAM_CHAT_ID=
QF_NOTIFICATIONS__MIN_SEVERITY=info      # debug | info | warning | critical


# =============================================================================
#  SECTION 9 — LANGUAGE MODEL (optional, off by default)
#
#  `null` returns a deterministic HOLD: no network, no credentials, no spend.
#  Any other provider requires QF_LLM__API_KEY and WILL incur API charges.
# =============================================================================

QF_LLM__PROVIDER=null                    # null | anthropic | openai
QF_LLM__MODEL=claude-sonnet-5
QF_LLM__API_KEY=
QF_LLM__MAX_TOKENS=1024
QF_LLM__TEMPERATURE=0.0                  # 0 = reproducible. A decision that changes
                                         # between identical inputs cannot be audited.
QF_LLM__TIMEOUT_SECONDS=30
QF_LLM__INTERVAL_SECONDS=300
QF_LLM__CANDLES_IN_PROMPT=100
QF_LLM__MIN_CONFIDENCE=0.65


# =============================================================================
#  SECTION 10 — UNATTENDED BOT (scripts/run_demo_bot.py)
#  All optional; the values shown are the built-in defaults.
# =============================================================================

# QF_BOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
# QF_BOT_TIMEFRAME=15m                   # the fill model rejects orders over 10% of a
#                                        # bar's volume; below 15m this bites hard
# QF_BOT_SESSION_ID=                     # stable across restarts, or state scatters
# QF_BOT_STRATEGIES=                     # blank = orchestrator selects from all 44
# QF_BOT_MAX_MEME=4
# QF_BOT_EQUITY_FROM_VENUE=
# QF_BOT_MAX_LEGS_PER_SYMBOL=
# QF_BOT_MAX_PER_CLASS=
